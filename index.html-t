<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Goaltipp | Prémium Futballtippek</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}
html{
  scroll-behavior:smooth;
}
body{
  font-family:'Inter',Arial,sans-serif;
  background:#050807;
  color:#fff;
  overflow-x:hidden;
}
/* háttér fények */
body:before{
  content:"";
  position:fixed;
  width:600px;
  height:600px;
  left:-250px;
  top:-200px;
  background:rgba(34,197,94,.13);
  filter:blur(120px);
  border-radius:50%;
  pointer-events:none;
}
body:after{
  content:"";
  position:fixed;
  width:500px;
  height:500px;
  right:-220px;
  top:300px;
  background:rgba(250,204,21,.08);
  filter:blur(120px);
  border-radius:50%;
  pointer-events:none;
}
a{
  text-decoration:none;
  color:inherit;
}
/* NAVBAR */
.navbar{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(5,8,7,.82);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,255,255,.07);
}
.nav{
  max-width:1200px;
  margin:auto;
  padding:18px 22px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.logo{
  font-size:25px;
  font-weight:900;
  letter-spacing:-1px;
}
.logo .ball{
  font-size:28px;
}
.logo span{
  color:#4ade80;
}
.navlinks{
  display:flex;
  gap:28px;
  list-style:none;
}
.navlinks a{
  color:#aeb8b2;
  font-size:14px;
  font-weight:700;
  transition:.2s;
}
.navlinks a:hover{
  color:#4ade80;
}
.nav-button{
  background:#facc15;
  color:#171305;
  padding:10px 17px;
  border-radius:10px;
  font-size:13px;
  font-weight:900;
}
/* HERO */
.hero{
  min-height:700px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:90px 20px;
  position:relative;
}
.hero-content{
  max-width:850px;
  position:relative;
  z-index:2;
}
.pill{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:9px 15px;
  border:1px solid rgba(74,222,128,.3);
  background:rgba(34,197,94,.09);
  border-radius:100px;
  color:#86efac;
  font-size:12px;
  font-weight:800;
  margin-bottom:25px;
}
.pulse{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#4ade80;
  box-shadow:0 0 15px #4ade80;
}
.hero h1{
  font-size:clamp(48px,8vw,90px);
  line-height:.98;
  letter-spacing:-5px;
  font-weight:900;
}
.hero h1 span{
  background:linear-gradient(90deg,#4ade80,#facc15);
  -webkit-background-clip:text;
  color:transparent;
}
.hero p{
  max-width:650px;
  margin:28px auto 0;
  color:#9ca9a2;
  line-height:1.7;
  font-size:17px;
}
.hero-buttons{
  display:flex;
  justify-content:center;
  gap:14px;
  flex-wrap:wrap;
  margin-top:34px;
}
.btn{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  padding:15px 24px;
  border-radius:12px;
  font-size:14px;
  font-weight:900;
  transition:.25s;
}
.btn-green{
  background:#22c55e;
  color:#041008;
  box-shadow:0 10px 30px rgba(34,197,94,.18);
}
.btn-green:hover{
  transform:translateY(-3px);
  background:#4ade80;
}
.btn-outline{
  border:1px solid #303b35;
  color:#fff;
  background:rgba(255,255,255,.025);
}
.btn-outline:hover{
  border-color:#4ade80;
  color:#4ade80;
}
/* HERO FOOTER */
.hero-stats{
  margin:60px auto 0;
  max-width:720px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}
.hero-stat{
  padding:18px;
  border:1px solid rgba(255,255,255,.07);
  background:rgba(255,255,255,.025);
  border-radius:15px;
}
.hero-stat strong{
  display:block;
  color:#4ade80;
  font-size:22px;
  margin-bottom:5px;
}
.hero-stat span{
  color:#77847d;
  font-size:11px;
}
/* SECTION */
.section{
  max-width:1200px;
  margin:auto;
  padding:90px 22px;
}
.title{
  text-align:center;
  font-size:38px;
  font-weight:900;
  letter-spacing:-1px;
}
.subtitle{
  color:#77847d;
  text-align:center;
  margin-top:12px;
  margin-bottom:45px;
}
/* TIPPEK */
.tipgrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}
.tipcard{
  position:relative;
  padding:27px;
  border:1px solid rgba(255,255,255,.08);
  background:linear-gradient(145deg,rgba(22,35,28,.8),rgba(9,14,11,.8));
  border-radius:22px;
  transition:.25s;
  overflow:hidden;
}
.tipcard:before{
  content:"";
  position:absolute;
  width:120px;
  height:120px;
  right:-50px;
  top:-50px;
  background:#22c55e;
  opacity:.06;
  filter:blur(30px);
  border-radius:50%;
}
.tipcard:hover{
  transform:translateY(-7px);
  border-color:rgba(74,222,128,.45);
}
.tag{
  display:inline-block;
  padding:6px 10px;
  border-radius:8px;
  background:rgba(34,197,94,.1);
  color:#4ade80;
  font-size:10px;
  font-weight:900;
  margin-bottom:18px;
}
.tipcard h3{
  font-size:20px;
  margin-bottom:18px;
}
.tiprow{
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-top:1px solid rgba(255,255,255,.06);
  color:#8e9993;
  font-size:13px;
}
.tiprow strong{
  color:#fff;
}
.odds{
  color:#4ade80!important;
  font-weight:900;
}
/* PRÉMIUM */
.premium{
  background:
    linear-gradient(rgba(8,13,10,.96),rgba(8,13,10,.96)),
    radial-gradient(circle at center,#1c542f,transparent 60%);
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.plans{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}
.plan{
  position:relative;
  background:rgba(255,255,255,.025);
  border:1px solid rgba(255,255,255,.09);
  border-radius:24px;
  padding:30px 22px;
  text-align:center;
  transition:.25s;
}
.plan:hover{
  transform:translateY(-7px);
  border-color:#4ade80;
}
.plan h3{
  font-size:21px;
  margin-bottom:18px;
}
.price{
  font-size:35px;
  font-weight:900;
  color:#4ade80;
}
.period{
  color:#6f7c74;
  font-size:12px;
  margin-top:5px;
}
.features{
  list-style:none;
  text-align:left;
  margin:25px 0;
  color:#aab5ae;
  line-height:2.2;
  font-size:13px;
}
.buy{
  display:block;
  width:100%;
  padding:14px;
  background:#22c55e;
  color:#041008;
  border-radius:11px;
  font-size:13px;
  font-weight:900;
  transition:.2s;
}
.buy:hover{
  background:#4ade80;
  transform:scale(1.02);
}
/* KIEMELT */
.plan.featured{
  border:1px solid #facc15;
  background:
    linear-gradient(145deg,rgba(55,45,7,.28),rgba(255,255,255,.025));
  box-shadow:0 20px 60px rgba(250,204,21,.07);
}
.plan.featured .price{
  color:#facc15;
}
.popular{
  position:absolute;
  top:-14px;
  left:50%;
  transform:translateX(-50%);
  background:#facc15;
  color:#171305;
  padding:7px 14px;
  border-radius:100px;
  font-size:10px;
  font-weight:900;
  white-space:nowrap;
}
.buy-gold{
  background:#facc15;
}
.buy-gold:hover{
  background:#fde047;
}
/* INFO */
.info{
  max-width:850px;
  margin:auto;
  text-align:center;
}
.info-box{
  padding:35px;
  background:rgba(255,255,255,.025);
  border:1px solid rgba(255,255,255,.07);
  border-radius:22px;
}
.info-box p{
  color:#929e97;
  line-height:1.8;
  margin-top:15px;
}
/* CTA */
.cta{
  max-width:900px;
  margin:20px auto 80px;
  padding:60px 25px;
  text-align:center;
  border-radius:28px;
  border:1px solid rgba(74,222,128,.2);
  background:
    radial-gradient(circle at center,rgba(34,197,94,.12),transparent 65%),
    rgba(255,255,255,.02);
}
.cta h2{
  font-size:36px;
  margin-bottom:13px;
}
.cta p{
  color:#89958e;
  margin-bottom:25px;
}
/* FOOTER */
footer{
  padding:45px 20px;
  text-align:center;
  border-top:1px solid rgba(255,255,255,.06);
  background:#030504;
}
.footer-logo{
  font-size:23px;
  font-weight:900;
  margin-bottom:10px;
}
.footer-logo span{
  color:#4ade80;
}
footer p{
  color:#59645e;
  font-size:12px;
  line-height:1.8;
}
/* MOBIL */
@media(max-width:950px){
  .plans{
    grid-template-columns:repeat(2,1fr);
  }
  .tipgrid{
    grid-template-columns:1fr;
  }
}
@media(max-width:650px){
  .nav{
    flex-direction:column;
    gap:15px;
  }
  .navlinks{
    gap:15px;
  }
  .nav-button{
    display:none;
  }
  .hero{
    min-height:auto;
    padding:75px 18px;
  }
  .hero h1{
    letter-spacing:-3px;
  }
  .hero-stats{
    grid-template-columns:1fr;
  }
  .plans{
    grid-template-columns:1fr;
  }
  .section{
    padding:65px 17px;
  }
  .title{
    font-size:30px;
  }
}
</style>
</head>
<body>
<!-- NAV -->
<nav class="navbar">
  <div class="nav">
<div class="logo">
  <span class="ball">⚽</span>
  <span>Goal</span>tipp
</div>
<ul class="navlinks">
  <li><a href="#tippek">Tippek</a></li>
  <li><a href="#premium">Prémium</a></li>
  <li><a href="#rolunk">Rólunk</a></li>
</ul>
<a href="#premium" class="nav-button">
  Prémium
</a>
  </div>
</nav>
<!-- HERO -->
<section class="hero">
  <div class="hero-content">
<div class="pill">
  <span class="pulse"></span>
  GOALTIPP • FUTBALLTIPPEK
</div>
<h1>
  A futball<br>
  <span>másik oldala.</span>
</h1>
<p>
  Mérkőzés-elemzések, ingyenes tippek és prémium tartalmak
  egy helyen. Válaszd ki a csomagod, és fedezd fel a Goaltippet.
</p>
<div class="hero-buttons">
  <a href="#premium" class="btn btn-green">
    ⭐ Prémium csomagok
  </a>
  <a href="#tippek" class="btn btn-outline">
    🔥 Ingyenes tippek
  </a>
</div>
<div class="hero-stats">
  <div class="hero-stat">
    <strong>⚽</strong>
    <span>FUTBALLTIPPEK</span>
  </div>
  <div class="hero-stat">
    <strong>🔥</strong>
    <span>FRISS TARTALMAK</span>
  </div>
  <div class="hero-stat">
    <strong>⭐</strong>
    <span>PRÉMIUM CSOMAGOK</span>
  </div>
</div>
  </div>
</section>
<!-- TIPPEK -->
<section class="section" id="tippek">
  <h2 class="title">
    🔥 Ingyenes tippek
  </h2>
  <p class="subtitle">
    Ízelítő a Goaltipp tartalmaiból.
  </p>
  <div class="tipgrid">
<div class="tipcard">
  <span class="tag">
    INGYENES TIPP
  </span>
  <h3>
    Barcelona – Real Madrid
  </h3>
  <div class="tiprow">
    <span>Tipp</span>
    <strong>
      Mindkét csapat gólt szerez
    </strong>
  </div>
  <div class="tiprow">
    <span>Odds</span>
    <strong class="odds">
      1.65
    </strong>
  </div>
</div>
<div class="tipcard">
  <span class="tag">
    INGYENES TIPP
  </span>
  <h3>
    Liverpool – Arsenal
  </h3>
  <div class="tiprow">
    <span>Tipp</span>
    <strong>
      Több mint 2,5 gól
    </strong>
  </div>
  <div class="tiprow">
    <span>Odds</span>
    <strong class="odds">
      1.80
    </strong>
  </div>
</div>
<div class="tipcard">
  <span class="tag">
    INGYENES TIPP
  </span>
  <h3>
    Bayern – Dortmund
  </h3>
  <div class="tiprow">
    <span>Tipp</span>
    <strong>
      Bayern győzelem
    </strong>
  </div>
  <div class="tiprow">
    <span>Odds</span>
    <strong class="odds">
      1.55
    </strong>
  </div>
</div>
  </div>
</section>
<!-- PREMIUM -->
<section class="premium" id="premium">
  <div class="section">
<h2 class="title">
  ⭐ Goaltipp Prémium
</h2>
<p class="subtitle">
  Válaszd ki a neked megfelelő hozzáférést.
</p>
<div class="plans">
  <!-- NAPI -->
  <div class="plan">
    <h3>📅 Napi</h3>
    <div class="price">
      500 Ft
    </div>
    <div class="period">
      1 nap hozzáférés
    </div>
    <ul class="features">
      <li>✓ Prémium tippek</li>
      <li>✓ Mérkőzés-elemzések</li>
      <li>✓ Prémium tartalmak</li>
    </ul>
    <a
      class="buy"
      href="https://buy.stripe.com/7sY4gB63Oggi8ey6519R600"
      target="_blank"
      rel="noopener">
      💳 Előfizetek
    </a>
  </div>
  <!-- HETI -->
  <div class="plan">
    <h3>📅 Heti</h3>
    <div class="price">
      2 000 Ft
    </div>
    <div class="period">
      7 nap hozzáférés
    </div>
    <ul class="features">
      <li>✓ Prémium tippek</li>
      <li>✓ Mérkőzés-elemzések</li>
      <li>✓ Prémium tartalmak</li>
    </ul>
    <a
      class="buy"
      href="https://buy.stripe.com/3cIfZj77S7JMamG0KH9R601"
      target="_blank"
      rel="noopener">
      💳 Előfizetek
    </a>
  </div>
  <!-- 2 HETI -->
  <div class="plan">
    <h3>📅 2 heti</h3>
    <div class="price">
      3 000 Ft
    </div>
    <div class="period">
      14 nap hozzáférés
    </div>
    <ul class="features">
      <li>✓ Prémium tippek</li>
      <li>✓ Mérkőzés-elemzések</li>
      <li>✓ Prémium tartalmak</li>
    </ul>
    <a
      class="buy"
      href="https://buy.stripe.com/3cI3cx2RC6FI0M6dxt9R602"
      target="_blank"
      rel="noopener">
      💳 Előfizetek
    </a>
  </div>
  <!-- HAVI -->
  <div class="plan featured">
    <div class="popular">
      ⭐ LEGKERESETTEBB
    </div>
    <h3>🏆 Havi</h3>
    <div class="price">
      10 000 Ft
    </div>
    <div class="period">
      30 nap hozzáférés
    </div>
    <ul class="features">
      <li>✓ Prémium tippek</li>
      <li>✓ Mérkőzés-elemzések</li>
      <li>✓ Prémium tartalmak</li>
      <li>✓ Kiemelt prémium csomag</li>
    </ul>
    <a
      class="buy buy-gold"
      href="https://buy.stripe.com/9B68wR1NyaVYfH09hd9R603"
      target="_blank"
      rel="noopener">
      💳 Előfizetek
    </a>
  </div>
</div>
<p style="text-align:center;color:#68746d;font-size:12px;margin-top:25px;">
  🔒 Biztonságos fizetés a Stripe rendszerén keresztül.
</p>
  </div>
</section>
<!-- RÓLUNK -->
<section class="section" id="rolunk">
  <div class="info">
<div class="info-box">
  <h2 class="title">
    ⚽ Rólunk
  </h2>
  <p>
    A Goaltipp futballtippekkel és mérkőzés-elemzésekkel
    foglalkozó oldal. Célunk, hogy az érdeklődők számára
    egyszerűen és átláthatóan elérhetővé tegyük
    az ingyenes és prémium tartalmakat.
  </p>
</div>
  </div>
</section>
<!-- CTA -->
<div class="cta">
  <h2>
    Készen állsz? ⚽
  </h2>
  <p>
    Válassz egy prémium csomagot, és fedezd fel a Goaltipp világát.
  </p>
  <a href="#premium" class="btn btn-green">
    ⭐ Csomagok megtekintése
  </a>
</div>
<!-- FOOTER -->
<footer>
  <div class="footer-logo">
    ⚽ <span>Goal</span>tipp
  </div>
  <p>
    Futballtippek • Mérkőzés-elemzések • Prémium tartalmak
  </p>
  <p style="margin-top:10px;">
    © 2026 Goaltipp • Minden jog fenntartva.
  </p>
</footer>
</body>
</html>